{
  "name": "facebook-marketing-intelligence-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply marketing_intelligence --local",
    "db:migrate:remote": "wrangler d1 migrations apply marketing_intelligence --remote",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/index.js && node --check src/lib/analyze.js && node --check src/lib/meta.js && node --check public/app.js"
  },
  "devDependencies": {
    "wrangler": "latest"
  }
}
