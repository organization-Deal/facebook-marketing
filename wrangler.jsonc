{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "facebook-marketing",
  "main": "src/index.js",

  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/webhooks/*",
      "/health"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB"
    }
  ],

  "vars": {
    "APP_ENV": "development",
    "MOCK_MODE": "true"
  }
}
